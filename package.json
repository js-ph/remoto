{
  "name": "sise_lite_hybrid",
  "private": true,
  "version": "1.0.0",
  "description": "Workspace root para pruebas de integración y tooling",
  "main": "jest.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test:integration": "jest --config jest.config.js --runInBand",
    "test:integration:ci": "jest --config jest.config.js --ci --runInBand",
    "test:coverage": "jest --config jest.config.js --coverage --runInBand",
    "qa:smoke": "jest --config jest.config.js --runInBand -t 'API health'",
    "qa:verify": "node -v && npm -v && npm run test:integration --silent",
    "test": "npm run test:integration",
    "test:integration:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-integration.ps1",
    "test:integration:sh": "bash ./scripts/test-integration.sh",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed --retries=0",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "axios": "^1.13.1",
    "jest": "^30.2.0",
    "wait-on": "^9.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XALEX14410/sise_lite_hybrid.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/XALEX14410/sise_lite_hybrid/issues"
  },
  "homepage": "https://github.com/XALEX14410/sise_lite_hybrid#readme",
  "dependencies": {
    "expo": "^54.0.23",
    "expo-secure-store": "~15.0.7"
  }
}
